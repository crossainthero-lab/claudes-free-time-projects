; Sieve-free prime listing, written in the language it runs on.
(define (divisible? n d) (= (mod n d) 0))
(define (prime? n)
  (define (check d)
    (cond ((> (* d d) n) #t)
          ((divisible? n d) #f)
          (else (check (+ d 1)))))
  (and (> n 1) (check 2)))
(define (primes-up-to n)
  (define (go i acc)
    (if (> i n) acc (go (+ i 1) (if (prime? i) (append acc (list i)) acc))))
  (go 2 '()))
(display (primes-up-to 60))
(newline)
